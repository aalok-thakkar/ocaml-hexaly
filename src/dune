; ocaml-hexaly bindings.
;
; Layout:
;   hexaly_shim.h                  - extern "C" surface
;   hexaly_shim_real.cpp           - real backend (#include's Hexaly C++ headers)
;   hexaly_shim_mock.cpp           - in-process brute-force mock for tests
;   hexaly_shim.cpp                - GENERATED by configure.sh; #include's one of the above
;   hexaly_stubs.c                 - OCaml C stubs (custom blocks + finalizers)
;   hexaly.{ml,mli}                - public OCaml interface
;
; Backend selection: HEXALY_BACKEND={real,mock} or auto-detect via HEXALY_HOME.

(library
 (name hexaly)
 (public_name hexaly)
 (libraries threads.posix)
 (foreign_stubs
  (language c)
  (names hexaly_stubs)
  (flags (:standard -O2 (:include c_flags.sexp))))
 (foreign_stubs
  (language cxx)
  (names hexaly_shim)
  (flags (:standard -O2 -std=c++17 (:include cxx_flags.sexp))))
 (c_library_flags (:include c_library_flags.sexp)))

; Probe the environment, pick the backend, and emit the dune-include flag
; files + a one-line hexaly_shim.cpp that selects real or mock. Runs at
; build time. The discover program is in config/ and uses
; dune-configurator for portability across Linux / macOS / Windows.
(rule
 (targets c_flags.sexp cxx_flags.sexp c_library_flags.sexp hexaly_shim.cpp)
 (deps hexaly_shim_real.cpp hexaly_shim_mock.cpp hexaly_shim.h)
 (action (run %{dep:config/discover.exe})))
