# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.1"
synopsis: "OCaml bindings for the Hexaly Optimizer"
description: """
Bindings to the C++ API of the Hexaly Optimizer (formerly LocalSolver), a commercial optimization solver. Covers boolean, integer, float, interval, list and set decision variables, the expression operators, multi-objective phases, callbacks, and inconsistency analysis.

Hexaly is proprietary and is not installed by this package. Get a license (academic, trial or commercial) from https://www.hexaly.com/ and point HEXALY_HOME at the install. If no install is found, the package builds a small brute-force mock instead, so that it compiles and its tests run without Hexaly. The mock is not a solver: Hexaly.create prints a warning when it is in use (unless HEXALY_BACKEND=mock), Hexaly.backend () reports which backend was built, and setting HEXALY_BACKEND=real makes the build fail instead of falling back."""
maintainer: ["Aalok Thakkar <thakkar@ashoka.edu.in>"]
authors: ["Aalok Thakkar"]
license: "MIT"
tags: [
  "optimization"
  "solver"
  "constraint-programming"
  "operations-research"
  "milp"
  "scheduling"
  "routing"
  "hexaly"
  "localsolver"
]
homepage: "https://github.com/aalok-thakkar/ocaml-hexaly"
doc: "https://aalok-thakkar.github.io/ocaml-hexaly"
bug-reports: "https://github.com/aalok-thakkar/ocaml-hexaly/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "4.14"}
  "dune-configurator"
  "conf-c++"
  "alcotest" {>= "1.5" & with-test}
  "fmt" {>= "0.9" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/aalok-thakkar/ocaml-hexaly.git"
